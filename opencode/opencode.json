{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "$HOME/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "$HOME/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.ssh/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.aws/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.gnupg/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.kube/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.docker/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.config/gcloud/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/.config/gh/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/Library/Keychains/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/Library/Application Support/Google/Chrome/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/Library/Application Support/BraveSoftware/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/Library/Application Support/Firefox/*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "$HOME/Library/Safari/*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "$HOME/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "$HOME/git/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "jq *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "code *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git * --force*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git * -f*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "gh api *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh auth token *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh auth logout *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh secret *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh variable *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh repo delete *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh repo archive *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh repo rename *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh release delete *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh cache delete *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "gh workflow disable *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rmdir *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "su *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "doas *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chmod *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chown *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "chgrp *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "xattr *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "diskutil *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "dd *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mkfs *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "newfs *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mount *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "umount *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "shutdown *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "reboot *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "halt *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "poweroff *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "launchctl *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "pmset *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "bun publish *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push * --delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push --delete*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push * :*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push :*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "aws *",
      "effect": "ask"
    }
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}
